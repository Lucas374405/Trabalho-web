<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="pure-g">
  <div class="pure-u-1">

    <h1>Lista de Filmes</h1>

    <a href="/" class="pure-button">
      <i class="fa-solid fa-house"></i>
      Inicial
    </a>

    <a href="/filmes/cadastrar" class="pure-button pure-button-primary">
      <i class="fa-solid fa-plus"></i>
      Cadastrar Filme
    </a>

    <hr>

    <table class="pure-table pure-table-bordered">
      <thead>
        <tr>
          <th>Filme</th>
          <th>Ano</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody>
        {{#each filmes}}
        <tr>
          <td>
            <a href="/filmes/{{this.id}}">
              {{this.nome}}
            </a>
          </td>

          <td>
            {{this.ano}}
          </td>

          <td>
            <a href="/filmes/{{this.id}}/editar" class="pure-button">
              <i class="fa-solid fa-pen-to-square"></i>
              Editar
            </a>

            <form action="/filmes/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">

              <button type="submit" class="pure-button">
                <i class="fa-solid fa-trash-can"></i>
                Excluir
              </button>

            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>

  </div>
</div>