<div class="pure-g">
    <div class="pure-u-1 pure-u-md-1-2">

        <h1>Editar Diretor</h1>

        <form action="/diretores/{{diretor.id}}?_method=PUT"
              method="POST"
              class="pure-form pure-form-stacked">

            <label for="nome">Nome do Diretor:</label>
            <input type="text"
                   id="nome"
                   name="nome"
                   value="{{diretor.nome}}">

            <label for="anoNascimento">Ano de Nascimento:</label>
            <input type="number"
                   id="anoNascimento"
                   name="anoNascimento"
                   value="{{diretor.anoNascimento}}">

            <label for="nacionalidade">Nacionalidade:</label>
            <input type="text"
                   id="nacionalidade"
                   name="nacionalidade"
                   value="{{diretor.nacionalidade}}">

            <br>

            <button type="submit" class="pure-button pure-button-primary">
                Editar
            </button>

            <a href="/diretores" class="pure-button">
                Voltar
            </a>

        </form>

    </div>
</div>