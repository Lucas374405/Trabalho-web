<div class="pure-g">
    <div class="pure-u-1 pure-u-md-1-2">

        <h1>Editar Ficha Técnica</h1>

        <form action="/Fichatecnica/{{fichaTecnica.id}}?_method=PUT"
              method="POST"
              class="pure-form pure-form-stacked">

            <label for="duracaoMinutos">Duração em Minutos:</label>
            <input type="number"
                   id="duracaoMinutos"
                   name="duracaoMinutos"
                   value="{{fichaTecnica.duracaoMinutos}}">

            <label for="orcamento">Orçamento:</label>
            <input type="number"
                   id="orcamento"
                   name="orcamento"
                   value="{{fichaTecnica.orcamento}}">

            <label for="bilheteria">Bilheteria:</label>
            <input type="number"
                   id="bilheteria"
                   name="bilheteria"
                   value="{{fichaTecnica.bilheteria}}">

            <br>

            <button type="submit" class="pure-button pure-button-primary">
                Editar
            </button>

            <a href="/Fichatecnica" class="pure-button">
                Voltar
            </a>

        </form>

    </div>
</div>