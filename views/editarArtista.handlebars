<div class="pure-g">
    <div class="pure-u-1 pure-u-md-1-2">

        <h1>Editar Artista</h1>

        <form action="/artistas/{{artista.id}}?_method=PUT"
              method="POST"
              class="pure-form pure-form-stacked">

            <label for="nome">Nome do Artista:</label>
            <input type="text"
                   id="nome"
                   name="nome"
                   value="{{artista.nome}}">

            <label for="anoNascimento">Ano de Nascimento:</label>
            <input type="number"
                   id="anoNascimento"
                   name="anoNascimento"
                   value="{{artista.anoNascimento}}">

            <label for="nomeArtistico">Nome artístico:</label>
            <input type="text"
                   id="nomeArtistico"
                   name="nomeArtistico"
                   value="{{artista.nomeArtistico}}">

            <label for="emAtividade">Em atividade?</label>
            <input type="checkbox"
                   id="emAtividade"
                   name="emAtividade"
                   {{#if artista.emAtividade}}checked{{/if}}>

            <label for="foto">Foto:</label>
            <input type="text"
                   id="foto"
                   name="foto"
                   value="{{artista.foto}}">

            <label for="filmes">Filmes:</label>
            <select id="filmes" name="filmes" multiple>

                {{#each filmes}}
                    <option value="{{this.id}}"
                        {{#if (eq this.id @root.artista.filmeId)}}selected{{/if}}>
                        {{this.nome}}
                    </option>
                {{/each}}

            </select>

            <br>

            <button type="submit" class="pure-button pure-button-primary">
                Editar
            </button>

            <a href="/artistas" class="pure-button">
                Voltar
            </a>

        </form>

    </div>
</div>