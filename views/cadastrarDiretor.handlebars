<div class="pure-g">
    <div class="pure-u-1 pure-u-md-1-2">

        <h1>Cadastrar Diretor</h1>

        <form action="/diretores" method="POST" class="pure-form pure-form-stacked">

            <label for="nome">Nome do Diretor:</label>
            <input type="text" id="nome" name="nome">

            <label for="anoNascimento">Ano de Nascimento:</label>
            <input type="number" id="anoNascimento" name="anoNascimento">

            <label for="nacionalidade">Nacionalidade:</label>
            <input type="text" id="nacionalidade" name="nacionalidade">

            <br>

            <button type="submit" class="pure-button pure-button-primary">
                Cadastrar
            </button>

            <a href="/diretores" class="pure-button">
                Voltar
            </a>

        </form>

    </div>
</div>