<div class="pure-g">
    <div class="pure-u-1 pure-u-md-1-2">

        <h1>Cadastrar Filme</h1>

        <form action="/filmes" method="POST" class="pure-form pure-form-stacked">

            <label for="nome">Nome do Filme:</label>
            <input type="text" id="nome" name="nome">

            <label for="ano">Ano:</label>
            <input type="number" id="ano" name="ano">

            <label for="diretorId">Diretor:</label>
            <select id="diretorId" name="diretorId">
                {{#each diretores}}
                    <option value="{{this.id}}">
                        {{this.nome}}
                    </option>
                {{/each}}
            </select>

            <label for="artistas">Artistas:</label>
            <select id="artistas" name="artistas" multiple>
                {{#each artistas}}
                    <option value="{{this.id}}">
                        {{this.nome}}
                    </option>
                {{/each}}
            </select>

            <br>

            <button type="submit" class="pure-button pure-button-primary">
                Cadastrar
            </button>

            <a href="/filmes" class="pure-button">
                Voltar
            </a>

        </form>

    </div>
</div>